{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },
      "customers": {
        "ClusterId": "customers",
        "Match": {
          "Path": "/customers/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "https+http://identity"
          }
        }
      },
      "customers": {
        "Destinations": {
          "primary": {
            "Address": "https+http://customers"
          }
        }
      }
    }
  }
}
