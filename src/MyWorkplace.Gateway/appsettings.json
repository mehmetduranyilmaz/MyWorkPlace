{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-register": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/identity/register" }
      },
      "identity-login": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/identity/login" }
      },
      "identity-well-known": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/identity/.well-known/{**catch-all}" }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" }
      },
      "customers": {
        "ClusterId": "customers",
        "Match": { "Path": "/customers/{**catch-all}" }
      },
      "inventory": {
        "ClusterId": "inventory",
        "AuthorizationPolicy": "pro-plan",
        "Match": { "Path": "/inventory/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/orders/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "https+http://identity" } }
      },
      "customers": {
        "Destinations": { "primary": { "Address": "https+http://customers" } }
      },
      "inventory": {
        "Destinations": { "primary": { "Address": "https+http://inventory" } }
      },
      "orders": {
        "Destinations": { "primary": { "Address": "https+http://orders" } }
      }
    }
  }
}
