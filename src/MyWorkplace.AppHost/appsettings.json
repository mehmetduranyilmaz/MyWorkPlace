{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Auth": {
    "Issuer": "myworkplace-identity",
    "Audience": "myworkplace-api",
    "MetadataAddress": "https+http://identity/identity/.well-known/openid-configuration",
    "MetadataRefreshInterval": "12:00:00"
  },
  "SigningKeys": {
    "Lifetime": "90.00:00:00",
    "PublishAhead": "1.00:00:00",
    "RetainAfterUse": "1.00:00:00",
    "CheckInterval": "01:00:00"
  }
}
