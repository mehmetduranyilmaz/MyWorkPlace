# Normalize line endings: LF everywhere (matches .editorconfig), except Windows scripts below.
* text=auto eol=lf

# Source files: always LF so diffs are identical on Windows, macOS and Linux.
*.cs       text eol=lf diff=csharp
*.csproj   text eol=lf
*.slnx     text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.sh       text eol=lf
*.http     text eol=lf

# Windows-only scripts need CRLF.
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary files
*.png      binary
*.jpg      binary
*.ico      binary
*.pfx      binary
